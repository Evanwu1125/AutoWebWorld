{
  "meta": {
    "app": "Q&A Community-Quora_app",
    "version": "1.0",
    "initial_page_id": "HOME",
    "terminal_pages": [
      "ASK_QUESTION_SUCCESS",
      "ANSWER_QUESTION_SUCCESS",
      "FOLLOW_TOPIC_SUCCESS",
      "UPVOTE_SUCCESS",
      "EDIT_PROFILE_SUCCESS"
    ],
    "complexity_profile": {
      "interceptors": {
        "cookie": true,
        "permissions": [
          "location"
        ],
        "captcha": false,
        "register_correction": false
      },
      "pages": {
        "min": 20,
        "max": 35
      },
      "actions": {
        "per_page_min": 4,
        "per_page_max": 6
      },
      "terminals": {
        "count": 5
      },
      "path_length": {
        "len": [
          6,
          8
        ],
        "shortest_only": true,
        "count_interceptors": false
      },
      "home_nav_variants": [
        "direct",
        "hover",
        "menu"
      ],
      "home_nav_coverage": "any",
      "list_filters": {
        "enabled": true,
        "fields_max": 4,
        "two_step_parity": false,
        "allowed_shapes": [
          "checkboxes",
          "sliders",
          "sort"
        ]
      }
    }
  },
